# 365step — environment. Every variable is optional; copy to .env.local to use one.

# Database. Unset -> SQLite at ./data/365step.db (zero setup).
# Set -> PostgreSQL / Supabase. The schema is created automatically on first connection.
# For Vercel use the pooled Supabase connection string (port 6543).
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Where the SQLite file lives, if not ./data/365step.db.
# SQLITE_PATH=./data/365step.db

# Enables the "Получить отзыв" button on seminar writing tasks (Claude gives
# teacher-style feedback; it never rewrites the student's text). Without it the
# instant rule-based draft checklist still works.
# ANTHROPIC_API_KEY=sk-ant-...
